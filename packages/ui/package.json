{
  "name": "@kidlearn/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./primitives/*": "./src/primitives/*.tsx"
  },
  "scripts": {
    "dev": "echo '@kidlearn/ui exports raw TypeScript - nothing to watch'",
    "build": "echo '@kidlearn/ui exports raw TypeScript - nothing to build'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tokens:generate": "tsx scripts/generate-tokens.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@kidlearn/tokens": "workspace:*",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slot": "^1.1.2",
    "class-variance-authority": "catalog:",
    "clsx": "^2.1.1",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@kidlearn/config": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "react": "^19",
    "react-dom": "^19",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
