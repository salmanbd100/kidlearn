{
  "extends": "@kidlearn/config/tsconfig/react-library.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  // `vitest.setup.ts` is in the compilation, not only in the test run: importing
  // `@testing-library/jest-dom/vitest` is what augments vitest's `Assertion` type
  // with `toBeInTheDocument` and friends. Left out, the matchers work at runtime
  // and fail `tsc`. Same arrangement as `apps/web`.
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vitest.setup.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules"]
}
