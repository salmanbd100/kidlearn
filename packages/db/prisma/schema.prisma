// Prisma schema for kidlearn — Supabase (PostgreSQL).
// Domain models are added incrementally by implementation files 03–06.
//
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Supabase pooler, port 6543, ?pgbouncer=true) — runtime.
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) — Prisma CLI migrations/introspection.
  directUrl = env("DIRECT_URL")
}

enum GradeLevel {
  NURSERY
  KG1
  KG2
}

enum Language {
  en
  bn
}

model Parent {
  id                   String         @id @default(uuid())
  // File 09 — the better-auth identity this domain row belongs to. Required:
  // a Parent that maps to no `User` could never sign in. The row is created
  // lazily on the first authenticated request (apps/server requireParent), so
  // "sign up" and "sign in" are one flow. Cascade means deleting the identity
  // deletes the domain row and, through ChildProfile, all of the child's data —
  // the synchronous right-to-erasure path (NFR-SAFE-05/06, wired up in file 10).
  userId               String         @unique
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleId             String         @unique
  email                String         @unique
  name                 String?
  avatarUrl            String?
  pinHash              String?
  consentGivenAt       DateTime?
  consentVersion       String?
  // File 10 — PIN brute-force guard. The counters live on the durable Parent
  // row rather than on the session, so clearing cookies cannot reset a lockout.
  //
  // Two counters, because they answer different questions and are forgiven at
  // different times. `pinFailedCount` is the allowance *within* the current
  // window — it is what the atomic slot claim in `parentSecurityService`
  // compares against, and a served cool-off restores it. `pinLockoutStrikes` is
  // how many cool-offs have been served in a row; it survives them and drives
  // the doubling, so the escalation cannot be reset by simply waiting. Only a
  // correct PIN clears both.
  pinFailedCount       Int            @default(0)
  pinLockoutStrikes    Int            @default(0)
  pinLockedUntil       DateTime?
  // File 10 — account-deletion confirmation: a single-use random token with a
  // short expiry. Both columns disappear with the row on a completed deletion.
  deleteToken          String?
  deleteTokenExpiresAt DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  children             ChildProfile[]
}

model AdminUser {
  id         String            @id @default(uuid())
  email      String            @unique
  name       String
  role       String            @default("admin")
  // No passwordHash: admin credentials live on the better-auth `User` row
  // (provider `credential`), reached through `authUserId`. File 31 shares the one
  // better-auth instance with parents rather than standing up a second identity
  // store — see the note at the top of apps/server/src/lib/auth.ts.
  //
  // Nullable, because this row is what *makes* somebody an admin (spec §4.3) and
  // it is written before the credential user exists: the seed script creates the
  // link. A row with no link cannot sign in, which is the correct state for a
  // revoked admin whose review history must survive.
  //
  // `SetNull` rather than `Cascade`: deleting the identity must not delete the
  // AdminUser row, because `AIGenerationJob.reviewer` points at it and an audit
  // trail that loses its reviewer is worse than one naming a disabled account
  // (FR-AI-08). Re-running the seed re-links it.
  authUserId String?           @unique
  authUser   User?             @relation(fields: [authUserId], references: [id], onDelete: SetNull)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  aiReviews  AIGenerationJob[]
}

model ChildProfile {
  id                String             @id @default(uuid())
  firstName         String
  age               Int // 3–6; validated by Zod at the API layer (file 11)
  gradeLevel        GradeLevel
  preferredLanguage Language           @default(en)
  avatarCharacterId String?
  avatarCharacter   Character?         @relation(fields: [avatarCharacterId], references: [id])
  parentId          String
  parent            Parent             @relation(fields: [parentId], references: [id], onDelete: Cascade)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  lessonProgress    LessonProgress[]
  quizResponses     QuizResponse[]
  rewards           RewardLedger[]
  characters        ChildCharacter[]
  streak            Streak?
  screenTime        ScreenTimeSetting?
  sessionEvents     SessionEvent[]
  weeklyReports     WeeklyReport[]

  @@index([parentId])
}

enum ContentStatus {
  draft
  in_review
  approved
  rejected
  published
  archived
}

enum MediaKind {
  video
  audio
  image
}

model MediaAsset {
  id                     String                    @id @default(uuid())
  url                    String
  kind                   MediaKind
  language               Language?
  createdAt              DateTime                  @default(now())
  worldMascots           World[]                   @relation("WorldMascot")
  lessonIntroAudios      LessonTranslation[]       @relation("LessonIntroAudio")
  lessonVideos           LessonTranslation[]       @relation("LessonVideo")
  lessonVideoPosters     LessonTranslation[]       @relation("LessonVideoPoster")
  activityPromptAudios   ActivityTranslation[]     @relation("ActivityPromptAudio")
  quizQuestionAudios     QuizQuestionTranslation[] @relation("QuizQuestionAudio")
  storyCovers            Story[]                   @relation("StoryCover")
  storyTitleNarrations   StoryTranslation[]        @relation("StoryTitleNarration")
  storyMoralNarrations   StoryTranslation[]        @relation("StoryMoralNarration")
  storyPageIllustrations StoryPage[]               @relation("StoryPageIllustration")
  storyPageNarrations    StoryPageTranslation[]    @relation("StoryPageNarration")
  badgeIcons             Badge[]                   @relation("BadgeIcon")
  characterAssets        Character[]               @relation("CharacterAsset")
}

model World {
  id   String @id @default(uuid())
  slug String @unique
  // The admin label, not the child-facing name — see `WorldTranslation`.
  name String

  palette       Json
  mascotAssetId String?
  mascotAsset   MediaAsset?        @relation("WorldMascot", fields: [mascotAssetId], references: [id])
  status        ContentStatus      @default(draft)
  lessons       Lesson[]
  translations  WorldTranslation[]
  // File 32 — the `AdminUser.id` that last created, edited, reordered or
  // transitioned this row. Not a foreign key: an audit stamp must outlive the
  // account that made it, and the only delete behaviours a FK could offer here
  // erase that fact or make a revoked admin undeletable.
  updatedBy     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  stories       Story[]
}

// The child-facing world name, per locale.
//
// Split from `World.name` because the two answer different questions: the column
// is the internal label a CMS list and an audit trail are built from, this is what
// a Bangla learner reads on the tile. Without it the read API could only ever
// serve one language's names while serving that child's narration in another.
model WorldTranslation {
  id       String   @id @default(uuid())
  worldId  String
  world    World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  language Language
  name     String

  @@unique([worldId, language])
}

model Subject {
  id   String @id @default(uuid())
  slug String @unique
  // The admin label — see `SubjectTranslation` for what a child reads.
  name String

  sortOrder    Int                  @default(0)
  gradeLevels  GradeLevel[]
  status       ContentStatus        @default(draft)
  topics       Topic[]
  translations SubjectTranslation[]
  // Who last touched this row — see `World.updatedBy`.
  updatedBy    String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([sortOrder])
}

/// The child-facing subject name, per locale. See `WorldTranslation`.
model SubjectTranslation {
  id        String   @id @default(uuid())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  language  Language
  name      String

  @@unique([subjectId, language])
}

model Topic {
  id        String  @id @default(uuid())
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  slug      String
  // The admin label — see `TopicTranslation` for what a child reads.
  name      String

  sortOrder    Int                @default(0)
  gradeLevels  GradeLevel[]
  status       ContentStatus      @default(draft)
  lessons      Lesson[]
  translations TopicTranslation[]
  // Who last touched this row — see `World.updatedBy`.
  updatedBy    String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([subjectId, slug])
  @@index([subjectId, sortOrder])
}

/// The child-facing topic name, per locale. See `WorldTranslation`.
model TopicTranslation {
  id       String   @id @default(uuid())
  topicId  String
  topic    Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  language Language
  name     String

  @@unique([topicId, language])
}

model Lesson {
  id                 String              @id @default(uuid())
  topicId            String
  topic              Topic               @relation(fields: [topicId], references: [id], onDelete: Cascade)
  worldId            String
  world              World               @relation(fields: [worldId], references: [id])
  slug               String
  // The admin label — see `LessonTranslation.title` for what a child reads.
  title              String
  sortOrder          Int                 @default(0)
  gradeLevels        GradeLevel[]
  status             ContentStatus       @default(draft)
  activityId         String?
  activity           Activity?           @relation(fields: [activityId], references: [id])
  quizId             String?
  quiz               Quiz?               @relation(fields: [quizId], references: [id])
  // File 30 — what a child meets for the first time in this lesson, as prefixed
  // tokens: `letter:A`, `word:apple`, `number:7`. The weekly report unions these
  // across the lessons a child *first completed* inside the week, which is what
  // makes "new letters this week" answerable without a second history table.
  //
  // A denormalised list rather than a join table: the aggregator only ever reads
  // the whole array, an unknown prefix is ignored rather than fatal, and a
  // `letter:A` typed twice across two lessons is deduped in the report. The admin
  // lesson editor (file 32) is what fills this in beyond the seeds.
  conceptsIntroduced String[]            @default([])
  translations       LessonTranslation[]
  // Who last touched this row — see `World.updatedBy`.
  updatedBy          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  progress           LessonProgress[]

  @@unique([topicId, slug])
  @@index([topicId, sortOrder])
  @@index([worldId])
}

model LessonTranslation {
  id                 String      @id @default(uuid())
  lessonId           String
  lesson             Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  language           Language
  /// The child-facing lesson title. See `WorldTranslation` for why it is here
  /// rather than only on `Lesson.title`.
  title              String
  introScript        String
  introAudioAssetId  String?
  introAudioAsset    MediaAsset? @relation("LessonIntroAudio", fields: [introAudioAssetId], references: [id])
  videoAssetId       String?
  videoAsset         MediaAsset? @relation("LessonVideo", fields: [videoAssetId], references: [id])
  // The still frame the player shows before the video can play (file 17,
  // NFR-PERF-02). Per-locale alongside the video because a poster with a word
  // burnt into it belongs to the language its video was produced in.
  videoPosterAssetId String?
  videoPosterAsset   MediaAsset? @relation("LessonVideoPoster", fields: [videoPosterAssetId], references: [id])

  @@unique([lessonId, language])
}

enum ActivityType {
  drag_drop
  trace
  match
  puzzle
}

enum QuizQuestionFormat {
  mcq
  match_pair
  drag_answer
  picture_select
}

model Activity {
  id            String                @id @default(uuid())
  type          ActivityType
  definition    Json
  schemaVersion Int                   @default(1)
  status        ContentStatus         @default(draft)
  translations  ActivityTranslation[]
  lessons       Lesson[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model ActivityTranslation {
  id                 String      @id @default(uuid())
  activityId         String
  activity           Activity    @relation(fields: [activityId], references: [id], onDelete: Cascade)
  language           Language
  promptAudioAssetId String?
  promptAudioAsset   MediaAsset? @relation("ActivityPromptAudio", fields: [promptAudioAssetId], references: [id])

  @@unique([activityId, language])
}

model Quiz {
  id        String         @id @default(uuid())
  title     String?
  status    ContentStatus  @default(draft)
  questions QuizQuestion[]
  lessons   Lesson[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model QuizQuestion {
  id            String                    @id @default(uuid())
  quizId        String
  quiz          Quiz                      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  format        QuizQuestionFormat
  definition    Json
  schemaVersion Int                       @default(1)
  sortOrder     Int
  translations  QuizQuestionTranslation[]
  responses     QuizResponse[]

  @@unique([quizId, sortOrder])
}

model QuizQuestionTranslation {
  id           String       @id @default(uuid())
  questionId   String
  question     QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  language     Language
  audioAssetId String?
  audioAsset   MediaAsset?  @relation("QuizQuestionAudio", fields: [audioAssetId], references: [id])

  @@unique([questionId, language])
}

model Story {
  id    String @id @default(uuid())
  slug  String @unique
  // The admin label, not the child-facing name — see `StoryTranslation`.
  title String

  // The authoring label for the moral (FR-STORY-03), same relationship to
  // `StoryTranslation.moral` as `title` has to the translated title.
  theme        String
  worldId      String
  world        World              @relation(fields: [worldId], references: [id])
  gradeLevels  GradeLevel[]
  coverAssetId String?
  coverAsset   MediaAsset?        @relation("StoryCover", fields: [coverAssetId], references: [id])
  status       ContentStatus      @default(draft)
  pages        StoryPage[]
  translations StoryTranslation[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

// The child-facing story title and moral, per locale (file 25, FR-STORY-05).
//
// Added by file 25 for the reason `document/database-design.md` recorded when file
// 05 settled the schema: `Story.title` and `Story.theme` are admin labels, and a
// library screen that read them directly would show a Bangla learner English
// covers over Bangla page text — the same defect the curriculum name translations
// fixed for lesson tiles.
//
// `titleAudioAsset` is what makes a cover tappable for a pre-reader: the title
// read aloud in their language. Nullable because the voice pipeline (file 36)
// records it, and a story is publishable before its narration exists.
model StoryTranslation {
  id                String      @id @default(uuid())
  storyId           String
  story             Story       @relation(fields: [storyId], references: [id], onDelete: Cascade)
  language          Language
  title             String
  moral             String?
  titleAudioAssetId String?
  titleAudioAsset   MediaAsset? @relation("StoryTitleNarration", fields: [titleAudioAssetId], references: [id])

  // The moral read aloud, for the reader's finish screen (file 26, FR-STORY-03).
  // Added because the moral is the one line of a story that is *only* text: the
  // pages have narration and the cover has its title spoken, so without this the
  // lesson of the story is the single thing a pre-reader cannot receive.
  moralAudioAssetId String?
  moralAudioAsset   MediaAsset? @relation("StoryMoralNarration", fields: [moralAudioAssetId], references: [id])

  @@unique([storyId, language])
}

model StoryPage {
  id                  String                 @id @default(uuid())
  storyId             String
  story               Story                  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  sortOrder           Int
  illustrationAssetId String?
  illustrationAsset   MediaAsset?            @relation("StoryPageIllustration", fields: [illustrationAssetId], references: [id])
  translations        StoryPageTranslation[]

  @@unique([storyId, sortOrder])
}

model StoryPageTranslation {
  id                    String      @id @default(uuid())
  storyPageId           String
  storyPage             StoryPage   @relation(fields: [storyPageId], references: [id], onDelete: Cascade)
  language              Language
  text                  String
  narrationAudioAssetId String?
  narrationAudioAsset   MediaAsset? @relation("StoryPageNarration", fields: [narrationAudioAssetId], references: [id])

  // Follow-along highlight timings for the recording above (file 26,
  // FR-STORY-02): `{ unit, spans: [{ start, end, tMs }] }`, validated against
  // `NarrationTimingsSchema` before it is served.
  //
  // On the translation row rather than on `MediaAsset` because the spans are
  // character offsets into *this row's* `text` — an asset shared between two
  // rows would carry offsets that only fit one of them. Null everywhere until
  // the voice pipeline (file 36) produces them; the reader renders plain text.
  narrationTimings Json?

  @@unique([storyPageId, language])
}

//--------part-6-----------
enum LessonStep {
  intro
  video
  activity
  quiz
  reward
}

enum RewardType {
  star
  coin
  badge
}

enum SessionEventType {
  heartbeat
  session_start
  session_end
  lesson_start
  // Added in file 16: the five per-step markers between lesson_start and
  // lesson_complete. Without them the time aggregation in file 27 can only see a
  // lesson's two endpoints, so an abandoned lesson contributes nothing.
  step_complete
  lesson_complete
  story_start
  story_complete
}

enum AIJobType {
  lesson
  story
  quiz
  audio
  image
}

enum AIJobStatus {
  pending
  generating
  awaiting_review
  approved
  rejected
  failed
}

enum AIReviewDecision {
  approve
  edit_then_approve
  reject
}

model LessonProgress {
  id           String       @id @default(uuid())
  childId      String
  child        ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  currentStep  LessonStep   @default(intro)
  completedAt  DateTime?
  score        Int?
  timeSpentSec Int          @default(0)
  updatedAt    DateTime     @updatedAt

  @@unique([childId, lessonId])
  // File 30 — the weekly report selects one child's completions inside a
  // `[weekStart, weekEnd)` window. Without this the same query is a scan of the
  // child's whole history, once per report generated.
  @@index([childId, completedAt])
}

model QuizResponse {
  id         String       @id @default(uuid())
  childId    String
  child      ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     Json
  isCorrect  Boolean
  // Taps until the question was answered right. `isCorrect` is only ever "the
  // first one was", so without this a struggle and a walkover are the same row.
  attempts   Int          @default(1)
  answeredAt DateTime     @default(now())

  @@index([childId, answeredAt])
}

model Badge {
  id          String         @id @default(uuid())
  slug        String         @unique
  name        String
  description String?
  ruleType    String // interpreted by the badge engine (file 24)
  rule        Json // e.g. { "count": 26, "topicSlug": "alphabet" }
  iconAssetId String?
  iconAsset   MediaAsset?    @relation("BadgeIcon", fields: [iconAssetId], references: [id])
  status      ContentStatus  @default(draft)
  ledger      RewardLedger[]
}

model RewardLedger {
  id         String       @id @default(uuid())
  childId    String
  child      ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  rewardType RewardType
  amount     Int // stars/coins granted; 1 for badge rows
  sourceType String // "lesson_completion" | "quiz_completion" | "quiz_correct_answers" | "story_completion" | "daily_activity" | ...
  sourceId   String? // id of the lesson/quiz/story that triggered the grant, or the local date for a once-a-day grant
  badgeId    String?
  badge      Badge?       @relation(fields: [badgeId], references: [id])
  createdAt  DateTime     @default(now())

  @@unique([childId, rewardType, sourceType, sourceId])
  @@index([childId, createdAt])
}

model Character {
  id         String           @id @default(uuid())
  slug       String           @unique
  name       String
  assetId    String?
  asset      MediaAsset?      @relation("CharacterAsset", fields: [assetId], references: [id])
  isDefault  Boolean          @default(false)
  unlockRule Json // e.g. { "coins": 50 } — interpreted in file 24
  status     ContentStatus    @default(draft)
  unlocks    ChildCharacter[]
  avatars    ChildProfile[]
}

model ChildCharacter {
  id          String       @id @default(uuid())
  childId     String
  child       ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  characterId String
  character   Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)
  unlockedAt  DateTime     @default(now())

  @@unique([childId, characterId])
}

model Streak {
  id               String       @id @default(uuid())
  childId          String       @unique
  child            ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  current          Int          @default(0)
  longest          Int          @default(0)
  lastActivityDate DateTime?    @db.Date
}

model ScreenTimeSetting {
  id                String       @id @default(uuid())
  childId           String       @unique
  child             ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  dailyLimitMinutes Int?
  windowStart       DateTime?    @db.Time(0)
  windowEnd         DateTime?    @db.Time(0)
  updatedAt         DateTime     @updatedAt
}

model SessionEvent {
  id         String           @id @default(uuid())
  childId    String
  child      ChildProfile     @relation(fields: [childId], references: [id], onDelete: Cascade)
  type       SessionEventType
  occurredAt DateTime         @default(now())
  payload    Json?

  @@index([childId, occurredAt])
  // File 31 — the admin DAU count is the first query here with no `childId` to
  // narrow on, so the composite index above cannot serve its day window.
  @@index([occurredAt])
}

model WeeklyReport {
  id        String       @id @default(uuid())
  childId   String
  child     ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  weekStart DateTime     @db.Date
  metrics   Json
  note      String?
  createdAt DateTime     @default(now())

  @@unique([childId, weekStart])
}

model AIGenerationJob {
  id         String            @id @default(uuid())
  type       AIJobType
  input      Json
  rawOutput  Json?
  status     AIJobStatus       @default(pending)
  reviewerId String?
  reviewer   AdminUser?        @relation(fields: [reviewerId], references: [id])
  decision   AIReviewDecision?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  reviewedAt DateTime?

  @@index([status, createdAt])
}

//--------part-9 · better-auth (identity) -------------------------------------
// GENERATED by `npx @better-auth/cli generate --config apps/server/src/lib/auth.ts`
// (better-auth 1.6.x). Do not hand-edit the field lists: re-run the CLI after
// changing `session.additionalFields` or adding a plugin in auth.ts.
//
// These four tables are better-auth's, not ours — hence the lowercase `@@map`
// names and string ids it generates for itself. Our domain rows link in by
// unique FK: `Parent.userId` (below) and `AdminUser.authUserId` (file 31).
//
// `Session.activeChildProfileId` comes from `session.additionalFields` in
// auth.ts (FR-AUTH-06). It is intentionally NOT a Prisma relation to
// ChildProfile: better-auth writes this column through its own adapter and
// knows nothing about our FKs, so the reference is validated at the API layer
// when the profile is activated (file 11). `Verification` is unused at MVP but
// the adapter requires it to exist.
model User {
  id            String     @id
  name          String
  email         String
  emailVerified Boolean    @default(false)
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  sessions      Session[]
  accounts      Account[]
  // Hand-added (not CLI-generated): the back-references for Parent.userId and
  // AdminUser.authUserId. Keep them when re-running the better-auth CLI.
  //
  // Both are optional and at most one is ever set: a Google sign-in provisions a
  // Parent and never an AdminUser, and the admin seed script provisions an
  // AdminUser and never a Parent. That disjointness is what keeps the two
  // principals separate (spec §4.3) while sharing one session store.
  parent        Parent?
  adminUser     AdminUser?

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String    @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeChildProfileId String?
  // File 10 — the 15-minute parental-PIN grant (FR-AUTH-04). A session field,
  // not a separate cookie: one source of truth, and signing out ends the grant.
  pinVerifiedUntil     DateTime?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
