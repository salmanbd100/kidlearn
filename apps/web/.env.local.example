# Copy to .env.local. Nothing here is a secret: the NEXT_PUBLIC_ values are
# shipped to the browser, and the rest is read at build time by next.config.ts.

# Base URL of apps/server. Defaults to http://localhost:4000 when unset.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Comma-separated origins that `next/image` may load MediaAsset URLs from —
# character art, badge icons, story illustrations. Unset until the content
# pipeline has somewhere to publish to; a remote image from an unlisted host
# throws at render time rather than failing quietly. See next.config.ts.
# MEDIA_ASSET_HOSTS=https://cdn.example.com
